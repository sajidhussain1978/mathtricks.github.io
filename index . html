// ===================== RENDER HELPERS =====================
function trickCardHTML(a){
  return `<div class="trick-card">
    <div class="thumb"><div class="calc-display"><span class="eq-line">${a.eq}</span></div></div>
    <div class="body">
      <div class="cat-tag">${a.cat}</div>
      <h3>${a.title}</h3>
      <p>${a.excerpt}</p>
      <div class="meta-row"><span>${a.read}</span></div>
      <a class="read-link" onclick="openArticle('${a.slug}')">Learn the Trick →</a>
    </div>
  </div>`;
}

document.getElementById('featuredGrid').innerHTML = articles.slice(0,6).map(trickCardHTML).join('');
document.getElementById('latestGrid').innerHTML = articles.slice(-3).map(trickCardHTML).join('');

// blog page with filters
const categories = ["All", ...new Set(articles.map(a=>a.cat))];
function renderFilters(active){
  document.getElementById('filterRow').innerHTML = categories.map(c=>
    `<button class="${c===active?'active':''}" onclick="filterBlog('${c}')">${c}</button>`
  ).join('');
}
function filterBlog(cat){
  renderFilters(cat);
  const list = cat==="All" ? articles : articles.filter(a=>a.cat===cat);
  document.getElementById('blogGrid').innerHTML = list.map(trickCardHTML).join('');
}
renderFilters("All");
filterBlog("All");

function openArticle(slug){
  const a = articles.find(x=>x.slug===slug);
  if(!a) return;
  document.getElementById('artCrumb').textContent = a.title;
  document.getElementById('artTitle').textContent = a.title;
  const relatedHTML = a.related.map(s=>{
    const r = articles.find(x=>x.slug===s);
    return r ? `<a onclick="openArticle('${r.slug}')">${r.title}</a>` : '';
  }).join('');
  document.getElementById('artBody').innerHTML = a.body + `
    <div class="related-box">
      <h4>Related Tricks</h4>
      <div class="related-links">${relatedHTML}</div>
    </div>`;
  go('article', true);
  window.scrollTo({top:0,behavior:'instant'});
}

// ===================== ROUTING =====================
function go(pageId){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+pageId).classList.add('active');
  document.querySelectorAll('nav.links button[data-page]').forEach(b=>{
    b.classList.toggle('current', b.dataset.page===pageId);
  });
  if(pageId!=='article') window.scrollTo({top:0,behavior:'smooth'});
  document.getElementById('navLinks').style.display='';
}
function toggleMobileNav(){
  const nav = document.getElementById('navLinks');
  nav.style.display = (nav.style.display==='flex') ? 'none' : 'flex';
  nav.style.flexDirection='column';
  nav.style.position='absolute';
  nav.style.top='64px';
  nav.style.right='0';
  nav.style.left='0';
  nav.style.background='#fff';
  nav.style.padding='16px 24px';
  nav.style.borderBottom='1px solid var(--line)';
}
</script>
